@page "/"
@rendermode InteractiveServer
@using BcReleasePlanPortal.Data
@using BcReleasePlanPortal.Domain
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<BcReleasePlanDbContext> DbFactory
@inject RoadmapTriageService Triage

<PageTitle>BC Release Plan Portal — Triage</PageTitle>

<div class="page">
    <header>
        <h1>Triage</h1>
        <p class="subtitle">Confirm or correct how each roadmap item was classified. A triaged item keeps your change type and modules on every future ingest — unless Microsoft's own wording turns it into a deprecation, retirement or breaking change, which sends it back here.</p>
    </header>

    @if (_items is null)
    {
        <p>Loading…</p>
    }
    else if (_items.Count == 0)
    {
        <p class="empty">Nothing ingested yet. Run <code>dotnet run --run-once</code> in <code>BcReleasePlanPortal.Worker</code>.</p>
    }
    else
    {
        <div class="summary">
            <span><strong>@_items.Count</strong> items</span>
            <span class="urgent"><strong>@_items.Count(i => IsUrgent(i.ChangeType))</strong> breaking / deprecation / retirement</span>
            <span class="needs-confirmation"><strong>@_items.Count(i => i.NeedsConfirmation)</strong> need confirmation</span>
            <span class="triaged"><strong>@_items.Count(i => i.TriagedAt is not null)</strong> triaged</span>
        </div>

        <nav class="tabs">
            <a href="@Href(SelectedProduct, queue: true)" class="@(ShowAll ? "" : "active")">Needs confirmation (@InProduct().Count(i => i.NeedsConfirmation))</a>
            <a href="@Href(SelectedProduct, queue: false)" class="@(ShowAll ? "active" : "")">All items (@InProduct().Count())</a>
        </nav>

        <nav class="product-tabs">
            <a href="@Href(null, !ShowAll)" class="@(SelectedProduct is null ? "active" : "")">All products</a>
            @foreach (var product in _items.Select(i => i.Product).Distinct().Order())
            {
                <a href="@Href(product, !ShowAll)" class="@(SelectedProduct == product ? "active" : "")">@product</a>
            }
        </nav>

        @if (_lastAction is not null)
        {
            <div class="last-action" role="status">
                <span>@_lastAction.Message</span>
                <button class="link-button" @onclick="UndoAsync" disabled="@_busy">Undo</button>
            </div>
        }

        @if (_error is not null)
        {
            <div class="error" role="alert">@_error</div>
        }

        var rows = Filtered().ToList();
        @if (rows.Count == 0)
        {
            <p class="empty">Nothing left to confirm here.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Modules</th>
                        <th>Change type</th>
                        <th>Status</th>
                        <th>Version</th>
                        <th>GA date</th>
                        <th class="actions-col">Triage</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in rows)
                    {
                        var editing = _editingId == item.Id;
                        <tr @key="item.Id" class="@(item.NeedsConfirmation ? "needs-confirmation-row" : "") @(editing ? "editing-row" : "")">
                            <td>
                                <div class="title">
                                    @if (item.Url is not null)
                                    {
                                        <a href="@item.Url" target="_blank" rel="noopener" title="@item.Title">@DisplayTitle(item.Title)</a>
                                    }
                                    else
                                    {
                                        <span title="@item.Title">@DisplayTitle(item.Title)</span>
                                    }
                                </div>
                                <div class="external-id">
                                    @if (item.Source == RoadmapItemSource.LearnDeprecation)
                                    {
                                        <span class="source-badge">Learn deprecation</span>
                                    }
                                    #@item.ExternalId · @item.Product · <a href="impact-notes/@item.Id">Impact note</a>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.DescriptionRaw))
                                {
                                    <details class="description">
                                        <summary>Description</summary>
                                        <p>@item.DescriptionRaw</p>
                                    </details>
                                }
                            </td>

                            @if (editing)
                            {
                                <td>
                                    <div class="module-picker">
                                        @foreach (var module in BcModules.All)
                                        {
                                            <label>
                                                <input type="checkbox" checked="@_editModules.Contains(module)" @onchange="e => ToggleModule(module, (bool)e.Value!)" />
                                                @module
                                            </label>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <select @bind="_editChangeType" aria-label="Change type">
                                        @foreach (var type in Enum.GetValues<RoadmapChangeType>().Where(t => t != RoadmapChangeType.Unknown))
                                        {
                                            <option value="@type">@type</option>
                                        }
                                    </select>
                                </td>
                            }
                            else
                            {
                                <td>
                                    @if (item.Modules.Count == 0)
                                    {
                                        <span class="muted">—</span>
                                    }
                                    else
                                    {
                                        @string.Join(", ", item.Modules)
                                    }
                                </td>
                                <td>
                                    <span class="change-type change-type--@item.ChangeType.ToString().ToLowerInvariant()">@item.ChangeType</span>
                                    @if (item.NeedsConfirmation)
                                    {
                                        <span class="needs-confirmation-badge" title="Rule-based classification is low-confidence — needs human triage">?</span>
                                    }
                                </td>
                            }

                            <td class="nowrap">@item.Status</td>
                            <td class="nowrap">@(item.TargetVersion ?? "—")</td>
                            <td class="nowrap">@(item.GaDate?.ToString("yyyy-MM") ?? "—")</td>
                            <td class="actions-col">
                                @if (editing)
                                {
                                    <button class="primary" @onclick="() => SaveAsync(item)" disabled="@_busy">Save</button>
                                    <button @onclick="CancelEdit" disabled="@_busy">Cancel</button>
                                }
                                else
                                {
                                    @if (item.TriagedAt is { } triagedAt)
                                    {
                                        <div class="triaged-mark" title="@triagedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")">✓ Triaged</div>
                                    }
                                    @if (item.NeedsConfirmation)
                                    {
                                        <button class="primary" @onclick="() => ConfirmAsync(item)" disabled="@_busy">Confirm</button>
                                    }
                                    <button @onclick="() => StartEdit(item)" disabled="@_busy">Edit</button>
                                    @if (item.TriagedAt is not null)
                                    {
                                        <button @onclick="() => ReopenAsync(item)" disabled="@_busy">Reopen</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "product")]
    public string? SelectedProduct { get; set; }

    /// <summary>The queue (items needing confirmation) is the default; ?view=all shows everything.</summary>
    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    private bool ShowAll => View == "all";

    private List<RoadmapItem>? _items;
    private Guid? _editingId;
    private RoadmapChangeType _editChangeType;
    private HashSet<string> _editModules = [];
    private bool _busy;
    private string? _error;
    private LastAction? _lastAction;

    /// <summary>What Undo restores: the item's triage state before the last write.</summary>
    private sealed record LastAction(string Message, Guid ItemId, RoadmapChangeType ChangeType, List<string> Modules, bool WasTriaged);

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        // Ordered client-side: SQLite can't translate ORDER BY over DateTimeOffset server-side.
        // Urgent items first — they're the ones a customer plan can't afford to miss.
        _items = (await db.RoadmapItems.AsNoTracking().ToListAsync())
            .OrderByDescending(i => IsUrgent(i.ChangeType))
            .ThenBy(i => i.GaDate ?? DateOnly.MaxValue)
            .ThenBy(i => i.Title)
            .ToList();
    }

    private IEnumerable<RoadmapItem> InProduct() =>
        _items!.Where(i => SelectedProduct is null || i.Product == SelectedProduct);

    // The row being edited stays visible even if it no longer matches the queue filter.
    private IEnumerable<RoadmapItem> Filtered() =>
        InProduct().Where(i => ShowAll || i.NeedsConfirmation || i.Id == _editingId);

    private static string Href(string? product, bool queue)
    {
        var query = new List<string>();
        if (product is not null) query.Add($"product={Uri.EscapeDataString(product)}");
        if (!queue) query.Add("view=all");
        return query.Count == 0 ? "/" : "/?" + string.Join("&", query);
    }

    private static bool IsUrgent(RoadmapChangeType t) =>
        t is RoadmapChangeType.BreakingChange or RoadmapChangeType.Deprecation or RoadmapChangeType.Retirement;

    private void StartEdit(RoadmapItem item)
    {
        _editingId = item.Id;
        _editChangeType = item.ChangeType == RoadmapChangeType.Unknown ? RoadmapChangeType.Enhancement : item.ChangeType;
        _editModules = [.. item.Modules];
        _error = null;
    }

    private void CancelEdit() => _editingId = null;

    private void ToggleModule(string module, bool on)
    {
        if (on) _editModules.Add(module); else _editModules.Remove(module);
    }

    private Task ConfirmAsync(RoadmapItem item) =>
        RunAsync(item, $"Confirmed “{Short(item.Title)}”.", () => Triage.ConfirmAsync(item.Id));

    private Task SaveAsync(RoadmapItem item) =>
        RunAsync(item, $"Saved “{Short(item.Title)}” as {_editChangeType}.", async () =>
        {
            await Triage.CorrectAsync(item.Id, _editChangeType, _editModules);
            _editingId = null;
        });

    private Task ReopenAsync(RoadmapItem item) =>
        RunAsync(item, $"Reopened “{Short(item.Title)}”.", () => Triage.ReopenAsync(item.Id));

    private async Task UndoAsync()
    {
        var undo = _lastAction!;
        _lastAction = null;
        await RunAsync(null, null, () => undo.WasTriaged
            ? Triage.CorrectAsync(undo.ItemId, undo.ChangeType, undo.Modules)
            : RestoreUntriagedAsync(undo));
    }

    /// <summary>Undo back to "never triaged": put the previous values back, then reopen.</summary>
    private async Task RestoreUntriagedAsync(LastAction undo)
    {
        if (undo.ChangeType != RoadmapChangeType.Unknown)
        {
            await Triage.CorrectAsync(undo.ItemId, undo.ChangeType, undo.Modules);
        }

        await Triage.ReopenAsync(undo.ItemId);
    }

    private async Task RunAsync(RoadmapItem? item, string? message, Func<Task> write)
    {
        _busy = true;
        _error = null;
        try
        {
            await write();
            if (item is not null && message is not null)
            {
                _lastAction = new LastAction(message, item.Id, item.ChangeType, [.. item.Modules], item.TriagedAt is not null);
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Couldn't save: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Roadmap titles all start with the product name; the product is already shown under the title.</summary>
    private static string DisplayTitle(string title) =>
        title.StartsWith("Dynamics 365 Business Central: ", StringComparison.Ordinal) ? title["Dynamics 365 Business Central: ".Length..] : title;

    private static string Short(string title)
    {
        var t = DisplayTitle(title);
        return t.Length > 60 ? t[..57] + "…" : t;
    }
}
